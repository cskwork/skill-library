# Example values only; the CLI does not automatically load .env files.
MCP_URL=http://127.0.0.1:3000/mcp
# Obtain from the real issuer or local development credential provisioner.
APP_MCP_TOKEN=
# Upstream credentials are server-only and distinct from the MCP token.
UPSTREAM_API_BASE_URL=https://api.example.com
UPSTREAM_API_TOKEN=
# Suggested application controls; implement their semantics in your project.
MCP_ENABLE_WRITES=false
MCP_MODE=fixture
